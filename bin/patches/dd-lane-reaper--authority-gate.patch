+# ── WTS 17cbc96c — three PURE classifiers for the drain's processed outcome. ──
+# Pure (argument in, string/status out, no I/O) so they can be extracted by name
+# and executed by a test harness, and so the three places that ask "did the wake
+# actually deliver?" cannot drift apart. The distinction they encode:
+#   injected / claimed / anything else  -> the gateway ACCEPTED and P1 continued
+#   refused-* (or the older quarantined*) -> the gateway REFUSED at admission;
+#                                            no model turn, no continuation
+classify_wake_proof() { # $1=processed-marker outcome $2=idempotency key -> wake token
+  local _inj="$1" _wkey="$2"
+  case "$_inj" in
+    refused-*|quarantined|quarantined:*)
+      printf 'wake=gateway-refused(%s,%s)\n' "$_inj" "$_wkey" ;;
+    *)
+      printf 'wake=gateway-accepted(%s,%s)\n' "$_inj" "$_wkey" ;;
+  esac
+}
+
+wake_was_refused() { # $1=wake_outcome -> exit 0 iff the gateway refused the callback
+  case "$1" in
+    wake=gateway-refused\(*) return 0 ;;
+  esac
+  return 1
+}
+
+wake_owns_delivery() { # $1=wake_outcome -> exit 0 iff the wake OWNS delivery
+  # gateway-refused is deliberately NOT here: a refused callback delivered nothing.
+  case "$1" in
+    wake=emitted\(*|wake=gateway-accepted\(*|wake=skipped\(dup:*|wake=skipped\(processed:*) return 0 ;;
+  esac
+  return 1
 }
 
